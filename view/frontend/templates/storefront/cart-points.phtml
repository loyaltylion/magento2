<?php
/** @var \Loyaltylion\Core\Block\CartPoints $block */
/** @var \Magento\Framework\Escaper $escaper */
$amount = $block->getSubtotalInMinorUnits();
if ($amount <= 0) {
    return;
}
$points = '<strong><span data-lion-points-for="' . $escaper->escapeHtmlAttr((string) $amount) . '"></span> '
    . $escaper->escapeHtml(__('points')) . '</strong>';
?>
<style>
    .loyaltylion-points { margin: 10px 0; }
    .loyaltylion-points:has([data-lion-points-for]:empty) { display: none; }
</style>
<div class="loyaltylion-points loyaltylion-cart-points">
    <?= /* @noEscape */ str_replace('%1', $points, $escaper->escapeHtml(__('This order earns %1'))) ?>
</div>
