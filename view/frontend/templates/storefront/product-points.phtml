<?php
/** @var \Loyaltylion\Core\Block\ProductPoints $block */
/** @var \Magento\Framework\Escaper $escaper */
$product = $block->getProduct();
if (!$product) {
    return;
}
$id = $escaper->escapeHtmlAttr($product->getId());
$points = '<strong><span data-lion-points-for-product-id="' . $id . '"></span> '
    . $escaper->escapeHtml(__('points')) . '</strong>';
?>
<style>
    .loyaltylion-points { margin: 10px 0; }
    .loyaltylion-points:has([data-lion-points-for]:empty),
    .loyaltylion-points:has([data-lion-points-for-product-id]:empty) { display: none; }
</style>
<div class="loyaltylion-points loyaltylion-product-points">
    <span hidden data-lion-price-for-product-id="<?= $id ?>"><?= $escaper->escapeHtml($block->getDisplayPrice($product)) ?></span>
    <?= /* @noEscape */ str_replace('%1', $points, $escaper->escapeHtml(__('Earn %1 on this purchase'))) ?>
</div>
<script>
    // Keeps the price the SDK reads in step with the page's price, which changes as the shopper picks a
    // configurable product's options. The SDK watches the price element and counts the points again.
    (function () {
        var productId = '<?= $id ?>';
        var price = document.querySelector('[data-lion-price-for-product-id="' + productId + '"]');
        var update = function (amount) {
            if (price && isFinite(amount) && amount > 0) { price.textContent = Number(amount).toFixed(2); }
        };
        // Luma's price box says so through jQuery, once RequireJS has loaded it.
        if (window.require) {
            window.require(['jquery'], function ($) {
                $(document).on('priceUpdated', '[data-role=priceBox][data-product-id="' + productId + '"]', function (e, prices) {
                    if (prices && prices.finalPrice) { update(prices.finalPrice.amount); }
                });
            });
        }
        // Hyvä's says so with a browser event.
        window.addEventListener('update-prices-' + productId, function (e) {
            if (e.detail && e.detail.finalPrice) { update(e.detail.finalPrice.amount); }
        });
    })();
</script>
