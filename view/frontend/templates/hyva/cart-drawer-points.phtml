<?php
/** @var \Loyaltylion\Core\Block\CartPoints $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->isOn()) {
    return;
}
?>
<?php // Inside the drawer's own Alpine component, whose `cart` is the shopper's cart section. The SDK reads the
      // amount when it renders, so it is asked to render again each time the subtotal changes. ?>
<template x-if="cart && Number(cart.loyaltylion_points_amount) > 0">
    <div class="loyaltylion-minicart-points mb-4"
         x-effect="cart.loyaltylion_points_amount; $nextTick(() => window.loyaltylion && window.loyaltylion.ui && window.loyaltylion.ui.refresh({ debounce: true }))">
        <?= $escaper->escapeHtml(__('This order earns')) ?>
        <strong><span :data-lion-points-for="cart.loyaltylion_points_amount"></span>
            <?= $escaper->escapeHtml(__('points')) ?></strong>
    </div>
</template>
