loyaltylion.init({ token: "<?= $escaper->escapeJs($connection->siteToken) ?>" });
<?php if ($connection->signsShoppers()): ?>
(function () {
    function signIn(shopper) {
        if (shopper && shopper.packet) {
            window.loyaltylion.authenticateCustomer(shopper.packet);
        }
    }
    // Hyvä announces the customer with an event. Luma keeps them in
    // customer-data, which needs the RequireJS that only Luma loads.
    window.addEventListener('private-content-loaded', function (event) {
        signIn((event.detail.data || {})['loyaltylion-shopper']);
    });
    if (typeof window.require === 'function') {
        window.require(['Magento_Customer/js/customer-data'], function (customerData) {
            var shopper = customerData.get('loyaltylion-shopper');
            shopper.subscribe(signIn);
            signIn(shopper());
        });
    }
})();
<?php endif; ?>
<?php if ($connection->addsFreeProductsToCart): ?>
// free-product.js is deferred, so it has run by DOMContentLoaded.
document.addEventListener('DOMContentLoaded', function () {
    window.loyaltylionFreeProduct(<?= /* @noEscape */ json_encode([
        'url' => $block->getUrl('loyaltylion/reward/add'),
        'message' => (string) __('Your reward is in your cart.'),
    ]) ?>);
});
<?php endif; ?>
<?php
$script = ob_get_clean();
if ($connection->addsFreeProductsToCart): ?>
<script defer src="<?= $escaper->escapeUrl($block->getViewFileUrl('Loyaltylion_Core::js/free-product.js')) ?>"></script>
<?php endif;
// Hyvä allows an inline script by registering it; elsewhere Magento's renderer does it.
if (isset($hyvaCsp)): ?>
<script><?= /* @noEscape */ $script ?></script>
<?php $hyvaCsp->registerInlineScript(); ?>
