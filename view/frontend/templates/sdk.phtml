$connection = $block->getConnection();
if (!$connection->showsSdk()) {
    return;
}
$sdkBaseUrl = $escaper->escapeJs('https://' . $connection->sdkHost);
ob_start();
// The loader is LoyaltyLion's own snippet, as its developer documentation and
// luna's Tonks::GenerateSnippet give it, with only the SDK's address filled in.
// Replace it whole when theirs changes; don't edit it here.
?>
!function(t,n){var e=n.loyaltylion||[];if(!e.isLoyaltyLion){n.loyaltylion=e,void 0===n.lion&&(n.lion=e),e.version=2,e.isLoyaltyLion=!0;var o=n.URLSearchParams,i=n.sessionStorage,r="ll_loader_revision",a=(new Date).toISOString().replace(/-/g,""),s="function"==typeof o?function(){try{var t=new o(n.location.search).get(r);return t&&i.setItem(r,t),i.getItem(r)}catch(t){return""}}():null;c("<?= /* @noEscape */ $sdkBaseUrl ?>/static/2/"+a.slice(0,8)+"/loader"+(s?"-"+s:"")+".js");var l=!1;e.init=function(t){if(l)throw new Error("Cannot call lion.init more than once");l=!0;var n=e._token=t.token;if(!n)throw new Error("Token must be supplied to lion.init");var o=[];function i(t,n){t[n]=function(){o.push([n,Array.prototype.slice.call(arguments,0)])}}"_push configure bootstrap shutdown on removeListener authenticateCustomer".split(" ").forEach(function(t){i(e,t)}),c("<?= /* @noEscape */ $sdkBaseUrl ?>/sdk/start/"+a.slice(0,11)+"/"+n+".js"),e._initData=t,e._buffer=o}}function c(n){var e=t.getElementsByTagName("script")[0],o=t.createElement("script");o.src=n,o.crossOrigin="",e.parentNode.insertBefore(o,e)}}(document,window);
(function () {
    var token = "<?= $escaper->escapeJs($connection->siteToken) ?>";
    var started = false;
    var waiting = [];

    function start(packet) {
        started = true;
        window.loyaltylion.init(
            packet ? { token: token, customer: packet.customer, auth: packet.auth } : { token: token }
        );
<?php if ($block->getData('order_confirmation_page')): ?>
        window.loyaltylion.configure({ orderConfirmationPage: true });
<?php endif; ?>
        waiting.forEach(function (run) { run(); });
    }
<?php if ($connection->signsShoppers()): ?>
    // The SDK settles what a shopper may do, and what belongs in their cart,
    // as it starts. So for a signed-in customer it waits for the store to say
    // who they are, rather than start as a guest who signs in a moment later.
    function know(shopper) {
        if (!started) {
            start(shopper.packet);
        } else if (shopper.packet) {
            window.loyaltylion.authenticateCustomer(shopper.packet);
        }
    }
    <?php if (!$block->isSignedIn()): ?>
    start(null);
    <?php endif; ?>

    // Hyvä announces its private content with an event, and leaves out a
    // section it has nothing for, which is a guest.
    window.addEventListener('private-content-loaded', function (event) {
        know((event.detail.data || {})['loyaltylion-shopper'] || { packet: null });
    });
    // Luma keeps it in customer-data, which needs the RequireJS that only Luma loads.
    if (typeof window.require === 'function') {
        window.require(['jquery', 'mage/url', 'Magento_Customer/js/customer-data'], function ($, url, customerData) {
            var shopper = customerData.get('loyaltylion-shopper');
            shopper.subscribe(function (loaded) {
                if ('packet' in loaded) {
                    know(loaded);
                }
            });
            // customer-data can't be asked for anything until the page has
            // set it up, which this promise waits for.
            customerData.getInitCustomerData().done(function () {
                if (started) {
                    return;
                }
                if ('packet' in shopper()) {
                    know(shopper());
                    return;
                }
                // Not customerData.reload: on an error answer its own handler
                // throws, so a callback added after it never runs, and the SDK
                // has to start whatever the answer.
                $.getJSON(url.build('customer/section/load'), { sections: 'loyaltylion-shopper' })
                    .done(function (sections) {
                        if (sections && sections['loyaltylion-shopper']) {
                            customerData.set('loyaltylion-shopper', sections['loyaltylion-shopper']);
                        }
                    })
                    .always(function () {
                        if (!started) {
                            start(null);
                        }
                    });
            });
        });
    }
<?php else: ?>
    start(null);
<?php endif; ?>
<?php if ($connection->addsFreeProductsToCart): ?>
    // free-product.js is deferred, so it has run by DOMContentLoaded, and its
    // hooks can only be registered on an SDK that has been started.
    document.addEventListener('DOMContentLoaded', function () {
        var register = function () {
            window.loyaltylionFreeProduct(<?= /* @noEscape */ json_encode([
                'url' => $block->getUrl('loyaltylion/reward/add'),
                'message' => (string) __('Your reward is in your cart.'),
            ], JSON_HEX_TAG | JSON_HEX_AMP | JSON_THROW_ON_ERROR) ?>);
        };
        if (started) {
            register();
        } else {
            waiting.push(register);
        }
    });
<?php endif; ?>
})();
<?php
$script = ob_get_clean();
if ($connection->addsFreeProductsToCart): ?>
<script defer src="<?= $escaper->escapeUrl($block->getViewFileUrl('Loyaltylion_Core::js/free-product.js')) ?>"></script>
<?php endif;
// Hyvä allows an inline script by registering it; elsewhere Magento's renderer does it.
if (isset($hyvaCsp)): ?>
<script><?= /* @noEscape */ $script ?></script>
    <?php $hyvaCsp->registerInlineScript(); ?>
<?php else: ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
<?php endif; ?>
