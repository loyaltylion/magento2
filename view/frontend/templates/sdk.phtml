<?php
/**
 * LoyaltyLion's SDK on every storefront page: the loader snippet, then the
 * signed-in shopper handed to it when the theme knows who they are.
 *
 * @var \Loyaltylion\Core\Block\Sdk $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
