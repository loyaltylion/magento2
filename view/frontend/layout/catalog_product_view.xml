<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Loyaltylion\Core\Block\ProductPoints" name="loyaltylion.product.points"
                   template="Loyaltylion_Core::storefront/product-points.phtml" after="product.info.price"
                   ifconfig="loyaltylion_core/storefront/product_points">
                <block class="Magento\Framework\View\Element\Template" name="loyaltylion.product.points.style"
                       template="Loyaltylion_Core::storefront/points-style.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
