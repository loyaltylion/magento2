<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block class="Magento\Framework\View\Element\Template" name="loyaltylion.checkout.redemption.cart"
                   template="Loyaltylion_Core::checkout-redemption/cart.phtml" before="checkout.cart.methods.bottom"
                   ifconfig="loyaltylion_core/checkout_redemption/enabled"/>
        </referenceContainer>
        <referenceContainer name="cart.summary">
            <block class="Loyaltylion\Core\Block\CartPoints" name="loyaltylion.cart.points"
                   template="Loyaltylion_Core::storefront/cart-points.phtml" after="checkout.cart.totals.container"
                   ifconfig="loyaltylion_core/storefront/cart_points">
                <block class="Magento\Framework\View\Element\Template" name="loyaltylion.cart.points.style"
                       template="Loyaltylion_Core::storefront/points-style.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
