<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <loyaltylion>
            <connection>
                <api_host>api.loyaltylion.com</api_host>
                <sdk_host>sdk.loyaltylion.net</sdk_host>
            </connection>
            <storefront>
                <free_product_cart>0</free_product_cart>
                <loyalty_page>1</loyalty_page>
                <loyalty_page_url_key>loyalty</loyalty_page_url_key>
                <menu_link>0</menu_link>
                <account_page>1</account_page>
                <checkout_redemption>1</checkout_redemption>
            </storefront>
        </loyaltylion>
    </default>
</config>
