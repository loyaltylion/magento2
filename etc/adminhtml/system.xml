<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="loyaltylion" translate="label" sortOrder="900">
            <label>LoyaltyLion</label>
        </tab>
        <section id="loyaltylion" translate="label" type="text" sortOrder="10"
                 showInDefault="0" showInWebsite="1" showInStore="0">
            <label>Connection</label>
            <tab>loyaltylion</tab>
            <resource>Loyaltylion_Core::config</resource>
            <group id="connection" translate="label comment" type="text" sortOrder="10"
                   showInDefault="0" showInWebsite="1" showInStore="0">
                <label>Connect this website to LoyaltyLion</label>
                <comment>Each website connects to one LoyaltyLion site. Find these values in LoyaltyLion under Settings.</comment>
                <field id="site_id" translate="label comment" type="text" sortOrder="10"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Site ID</label>
                    <comment>The number after /sites/ in the address bar when you are signed in to LoyaltyLion.</comment>
                    <validate>validate-digits</validate>
                </field>
                <field id="site_token" translate="label" type="text" sortOrder="20"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Site token</label>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="30"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>API key</label>
                    <comment>Needs the write_orders and write_customers scopes. Sends this website's orders and customers to LoyaltyLion.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="sdk_token" translate="label comment" type="obscure" sortOrder="40"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>SDK secret token</label>
                    <comment>Signs each shopper in to your loyalty program on the storefront.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <!-- Not shown in the admin: set with bin/magento config:set to point a store at another LoyaltyLion environment. -->
                <field id="api_host" type="text" sortOrder="100" showInDefault="0" showInWebsite="0" showInStore="0">
                    <label>API host</label>
                </field>
                <field id="sdk_host" type="text" sortOrder="110" showInDefault="0" showInWebsite="0" showInStore="0">
                    <label>SDK host</label>
                </field>
            </group>
            <group id="storefront" translate="label" type="text" sortOrder="20"
                   showInDefault="0" showInWebsite="1" showInStore="0">
                <label>Storefront</label>
                <field id="free_product_cart" translate="label comment" type="select" sortOrder="10"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Add claimed free products to the cart</label>
                    <comment>When a shopper claims a free product reward, put the product in their cart at no charge instead of showing them a code.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="loyalty_page" translate="label comment" type="select" sortOrder="20"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Show the loyalty page</label>
                    <comment>A page on your store that holds your loyalty program, at the address below. A page of your own at the same address is shown instead.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="loyalty_page_url_key" translate="label comment" type="text" sortOrder="30"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Loyalty page address</label>
                    <comment>What comes after your store's address, such as loyalty.</comment>
                    <depends>
                        <field id="loyalty_page">1</field>
                    </depends>
                </field>
                <field id="menu_link" translate="label" type="select" sortOrder="40"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Link the loyalty page from the main menu</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="loyalty_page">1</field>
                    </depends>
                </field>
                <field id="account_page" translate="label comment" type="select" sortOrder="50"
                       showInDefault="0" showInWebsite="1" showInStore="0">
                    <label>Show Rewards in the customer's account</label>
                    <comment>Adds a Rewards page to the account menu of signed-in shoppers.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
