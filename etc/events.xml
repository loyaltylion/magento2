<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="loyaltylion_queue_order" instance="Loyaltylion\Core\Observer\QueueOrder"/>
    </event>
    <event name="customer_save_after">
        <observer name="loyaltylion_queue_customer" instance="Loyaltylion\Core\Observer\QueueCustomer"/>
    </event>
    <event name="newsletter_subscriber_save_after">
        <observer name="loyaltylion_queue_newsletter_signup" instance="Loyaltylion\Core\Observer\QueueNewsletterSignup"/>
    </event>
    <event name="customer_delete_after">
        <observer name="loyaltylion_queue_customer_deletion" instance="Loyaltylion\Core\Observer\QueueCustomerDeletion"/>
    </event>
    <event name="sales_quote_collect_totals_before">
        <observer name="loyaltylion_hold_reward_lines" instance="Loyaltylion\Core\Observer\HoldRewardLines"/>
    </event>
    <event name="sales_quote_remove_item">
        <observer name="loyaltylion_release_removed_reward_line" instance="Loyaltylion\Core\Observer\ReleaseRemovedRewardLine"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="loyaltylion_check_reward_lines" instance="Loyaltylion\Core\Observer\CheckRewardLinesAtOrder"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="loyaltylion_retire_reward_coupons" instance="Loyaltylion\Core\Observer\RetireRewardCoupons"/>
    </event>
</config>
