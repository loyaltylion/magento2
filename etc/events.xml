<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="loyaltylion_queue_order" instance="Loyaltylion\Core\Observer\QueueOrder"/>
    </event>
    <event name="customer_save_after">
        <observer name="loyaltylion_queue_customer" instance="Loyaltylion\Core\Observer\QueueCustomer"/>
    </event>
    <event name="customer_delete_after">
        <observer name="loyaltylion_queue_customer_deletion" instance="Loyaltylion\Core\Observer\QueueCustomerDeletion"/>
    </event>
</config>
