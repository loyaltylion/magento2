<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_register_success">
        <observer name="customer_register_success_loyaltylion_observer"
                  instance="Loyaltylion\Core\Model\Observer\RegisterObserver"/>
    </event>
    <event name="checkout_submit_all_after">
        <observer name="checkout_submit_all_after_loyaltylion_observer"
                  instance="Loyaltylion\Core\Model\Observer\OrderCreateObserver"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="checkout_submit_all_after_loyaltylion_observer"
                  instance="Loyaltylion\Core\Model\Observer\OrderUpdateObserver"/>
    </event>
    <event name="customer_email_changed">
        <observer name="customer_email_changed_loyaltylion_observer"
                  instance="Loyaltylion\Core\Model\Observer\CustomerEmailChangedObserver"/>
    </event>
    <event name="customer_delete_after">
        <observer name="customer_delete_after_loyaltylion_observer"
                  instance="Loyaltylion\Core\Model\Observer\CustomerDeleteObserver"/>
    </event>
    <event name="newsletter_subscriber_save_after">
        <observer name="newsletter_subscriber_save_after_loyaltylion_observer"
                  instance="Loyaltylion\Core\Model\Observer\NewsletterSubscribeObserver"/>
    </event>
    <event name="sales_quote_collect_totals_before">
        <observer name="sales_quote_collect_totals_before_loyaltylion_free_product"
                  instance="Loyaltylion\Core\Model\Observer\FreeProductQuoteObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="sales_model_service_quote_submit_before_loyaltylion_free_product"
                  instance="Loyaltylion\Core\Model\Observer\FreeProductOrderObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="sales_model_service_quote_submit_success_loyaltylion_free_product"
                  instance="Loyaltylion\Core\Model\Observer\FreeProductPlacedObserver"/>
    </event>
</config>
