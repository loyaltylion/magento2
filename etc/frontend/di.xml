<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Api\AccountManagementInterface">
        <plugin name="loyaltylion_queue_registration" type="Loyaltylion\Core\Plugin\QueueRegistration"/>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="loyaltylion-shopper" xsi:type="string">Loyaltylion\Core\CustomerData\Shopper</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="loyaltylion_cart_points_amount" type="Loyaltylion\Core\Plugin\AddPointsAmountToCartData"/>
    </type>
    <type name="Magento\Checkout\Block\Cart\Sidebar">
        <plugin name="loyaltylion_minicart_points" type="Loyaltylion\Core\Plugin\AddPointsToMinicart"/>
    </type>
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <!-- After the CMS router (60), so a merchant's own page at the same address wins. -->
                <item name="loyaltylion" xsi:type="array">
                    <item name="class" xsi:type="string">Loyaltylion\Core\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">70</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
