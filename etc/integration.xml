<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Integration:etc/integration/integration.xsd">
    <!-- Magento reads this on every setup:upgrade. Changing the resources makes it recreate the integration,
         which the merchant then approves again under System > Integrations. -->
    <integration name="LoyaltyLion">
        <email>support@loyaltylion.com</email>
        <endpoint_url>https://app.loyaltylion.com/magento2/callback</endpoint_url>
        <identity_link_url>https://app.loyaltylion.com/magento2/link</identity_link_url>
        <resources>
            <!-- Each group is something LoyaltyLion calls, with the parents Magento needs listed above it. -->
            <!-- Reward codes: cart price rules and their coupons -->
            <resource name="Magento_Backend::marketing"/>
            <resource name="Magento_CatalogRule::promo"/>
            <resource name="Magento_SalesRule::quote"/>
            <!-- Reading orders, to catch up on any the module could not send -->
            <resource name="Magento_Sales::sales"/>
            <resource name="Magento_Sales::sales_operation"/>
            <resource name="Magento_Sales::sales_order"/>
            <resource name="Magento_Sales::actions"/>
            <resource name="Magento_Sales::actions_view"/>
            <!-- Reading the catalogue, for the product a reward gives -->
            <resource name="Magento_Catalog::catalog"/>
            <resource name="Magento_Catalog::catalog_inventory"/>
            <resource name="Magento_Catalog::products"/>
            <resource name="Magento_Catalog::categories"/>
            <!-- Reading websites and customer groups, to connect each website to its LoyaltyLion site -->
            <resource name="Magento_Backend::stores"/>
            <resource name="Magento_Backend::stores_settings"/>
            <resource name="Magento_Backend::store"/>
            <!-- Saving a website's LoyaltyLion settings when the store is connected -->
            <resource name="Magento_Config::config"/>
            <resource name="Loyaltylion_Core::config"/>
            <resource name="Magento_Customer::customer"/>
            <resource name="Magento_Customer::group"/>
            <!-- Writing a member's tier onto their customer, and moving them to their tier's group -->
            <resource name="Magento_Customer::manage"/>
        </resources>
    </integration>
</config>
