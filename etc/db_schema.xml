<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="loyaltylion_outbox" resource="default" engine="innodb"
           comment="Orders and customers whose current state LoyaltyLion has not been sent yet">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="kind" length="32" nullable="false"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="payload" length="255" nullable="true"
                comment="What to send for a row whose entity is gone by the time it is sent"/>
        <column xsi:type="varchar" name="state" length="16" nullable="false" default="waiting"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="version" unsigned="true" nullable="false" default="1"
                comment="Raised each time the entity changes again, so a send in flight leaves the row for the next one"/>
        <column xsi:type="timestamp" name="available_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="varchar" name="last_error" length="255" nullable="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="LOYALTYLION_OUTBOX_KIND_ENTITY_ID_WEBSITE_ID">
            <column name="kind"/>
            <column name="entity_id"/>
            <column name="website_id"/>
        </constraint>
        <index referenceId="LOYALTYLION_OUTBOX_STATE_AVAILABLE_AT" indexType="btree">
            <column name="state"/>
            <column name="available_at"/>
        </index>
    </table>
</schema>
